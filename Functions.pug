-

  class YamatoDaiwaPugCSharpStaticPreview {

    /**
     * @public
     * @param { string } template
     * @param { object } variables
     * @return { string }
     * */
    static generateStringFromTemplate(template, variables) {

      let outputString;

      for (const [variableName, variableValue] of Object.entries(variables)) {
        outputString = template.replaceAll(new RegExp(`\\{\\{\\s*${ variableName }\\s*\\}\\}`, "gu"), variableValue);
      }

      return outputString;

    }

  }

  /** @type { typeof YamatoDaiwaPugCSharpStaticPreview } */
  const YD_PCS_SP = YamatoDaiwaPugCSharpStaticPreview;
